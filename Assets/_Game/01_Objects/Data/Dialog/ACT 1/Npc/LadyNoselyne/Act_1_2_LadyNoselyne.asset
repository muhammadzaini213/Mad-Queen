  m_Script: {fileID: 11500000, guid: 71526196193300893bd908a673f4c252, type: 3}
  m_Name: Act_1_2_LadyNoselyne
  m_EditorClassIdentifier: Assembly-CSharp::DialogBucket
  lines:
  - speakerName: Lady Noselyne
    text: "A cat? Oh, I do adore cats! My cousin had one once, a rather unpleasant
      creature, I believe that was because it disliked the wallpaper. We had the
      same problem at my house, you see, when we redecorated the drawing room last
      spring\u2014 "

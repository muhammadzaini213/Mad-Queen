  m_Script: {fileID: 11500000, guid: 71526196193300893bd908a673f4c252, type: 3}
  m_Name: 01_Act1_Aristoctrat Woman_1
  m_EditorClassIdentifier: Assembly-CSharp::DialogBucket
  lines:
  - speakerName: Aristocrat Woman
    text: '"Have you heard the latest news, my dear? It appears Lady Johanna is already
      seeking a new suitor."'
  - speakerName: Aristocrat Woman
    text: '"Rumors says the gentleman vanished into thin air without ever having
      consummated the marriage! "'
  - speakerName: Aristocrat Woman
    text: "\"Can you fathom the indignity? Not a single marital duty was fulfilled
      before he fled! Poor little bird\u2026\""
